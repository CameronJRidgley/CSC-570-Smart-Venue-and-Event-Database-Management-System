# App
APP_ENV=development
APP_NAME=Smart Event Management API
API_V1_PREFIX=/api

# PostgreSQL - Update these to match your pgAdmin setup
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/event_mgmt

# MongoDB - Update these to match your MongoDB Compass setup
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=event_mgmt

# Auth / JWT
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Logging
LOG_LEVEL=INFO
